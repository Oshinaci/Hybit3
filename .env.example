# ==============================================================================
# HYBIT WEB3 APPLICATION ENVIRONMENT CONFIGURATION
# ==============================================================================
# Security Notice:
# - Never commit real private keys or seed phrases.
# - Client-side variables (prefixed with VITE_) are public in browser bundles.
# - Sensitive backend credentials must never have the VITE_ prefix.
# ==============================================================================

# Privy Embedded Wallet Auth (https://dashboard.privy.io)
VITE_PRIVY_APP_ID=

# Primary Blockchain Network Configuration (Base Sepolia / Base Mainnet)
VITE_CHAIN_ID=84532
VITE_RPC_URL=https://sepolia.base.org

# Supabase Client Configuration (Indexing / Metadata)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
